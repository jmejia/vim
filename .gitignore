# nvim-pack-lock.json IS tracked in this fork. Upstream kickstart ignores it to
# avoid merge conflicts; a personal fork wants it -- see :help vim.pack-lockfile.
# It pins every plugin to an exact rev, so both machines end up on identical
# versions instead of whatever HEAD happened to be at clone time.
# nvim-pack-lock.json

# Machine-specific overrides. lua/custom/plugins/init.lua auto-loads every .lua
# file in that directory, so this is the seam for anything that shouldn't be
# shared between machines.
lua/custom/plugins/local.lua

